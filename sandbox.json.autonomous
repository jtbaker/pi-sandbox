{
  "permissionPromptTimeoutSeconds": 10,
  "filesystem": {
    "allowWrite": [".", "/tmp", "/root/.npm", "/root/.cache", "/root/.local/share", "/root/.config"],
    "denyRead": ["/root/.pi", "/root/.omp", "/root/.pi-host", "/root/.omp-host"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}